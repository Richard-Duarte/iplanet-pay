# Supabase (quando preenchido, auth real é usado)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (links de indicação)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pix / Mercado Pago (nunca commitar valores reais)
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=

# Sem credenciais, o app entra em modo demo automaticamente.
# Force explicitamente:
USE_MOCK_AUTH=true
